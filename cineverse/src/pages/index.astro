
---
import { supabase } from "../lib/supabase";
import MovieSection from "../components/MovieSection.astro";

const mediaFields = `
  id,
  slug,
  title,
  poster_url,
  backdrop_url,
  video_type,
  media_type,
  imdb_rating,
  release_year,
  created_at,
  media_categories (
    category:categories (
      id,
      name,
      slug
    )
  )
`;

const [
  { data: moviesData, error: moviesError },
  { data: seriesData, error: seriesError },
  { data: topMoviesData, error: topMoviesError },
  { data: topSeriesData, error: topSeriesError },
] = await Promise.all([
  supabase
    .from("media")
    .select(mediaFields)
    .eq("media_type", "movie")
    .eq("is_published", true)
    .order("created_at", { ascending: false })
    .limit(24),

  supabase
    .from("media")
    .select(mediaFields)
    .eq("media_type", "series")
    .eq("is_published", true)
    .order("created_at", { ascending: false })
    .limit(24),

  supabase
    .from("media")
    .select(mediaFields)
    .eq("media_type", "movie")
    .eq("is_published", true)
    .not("imdb_rating", "is", null)
    .order("imdb_rating", { ascending: false })
    .limit(12),

  supabase
    .from("media")
    .select(mediaFields)
    .eq("media_type", "series")
    .eq("is_published", true)
    .not("imdb_rating", "is", null)
    .order("imdb_rating", { ascending: false })
    .limit(12),
]);

if (moviesError) console.error("Movies query:", moviesError);
if (seriesError) console.error("Series query:", seriesError);
if (topMoviesError) console.error("Top movies query:", topMoviesError);
if (topSeriesError) console.error("Top series query:", topSeriesError);

const movies = moviesData ?? [];
const series = seriesData ?? [];
const topMovies = topMoviesData ?? [];
const topSeries = topSeriesData ?? [];

const allMedia = [...movies, ...series, ...topMovies, ...topSeries];

const years = [
  ...new Set(
    allMedia
      .map((item) => item.release_year)
      .filter((year): year is number => year !== null && year !== undefined)
  ),
].sort((a, b) => b - a);

const categoryMap = new Map<string, string>();

for (const item of allMedia) {
  for (const relation of item.media_categories ?? []) {
    const category = relation.category;

    if (category?.name) {
      categoryMap.set(
        category.slug || category.name.toLowerCase(),
        category.name
      );
    }
  }
}

const categories = [...categoryMap.entries()].sort((a, b) =>
  a[1].localeCompare(b[1])
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Discover movies and TV series on CineVerse. Explore popular titles, release years, genres and IMDb ratings."
    />
    <meta name="theme-color" content="#09090f" />
    <title>CineVerse | Movies & TV Series</title>
  </head>

