    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <span class="hero-label">
            <span class="live-dot"></span>
            YOUR CINEMATIC UNIVERSE
          </span>

          <h1>
            Discover your next
            <span class="gradient-text">favorite story.</span>
          </h1>

          <p>
            Explore movies and TV series, discover hidden gems, and find your
            next unforgettable watch.
          </p>

          <a class="hero-button" href="#browse">
            Explore Collection
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="hero-decoration" aria-hidden="true">
          <div class="orbit orbit-one"></div>
          <div class="orbit orbit-two"></div>
          <div class="orbit orbit-three"></div>
          <div class="orbit-core">C</div>
        </div>
      </section>

      <div class="browse-layout" id="browse">
        <aside class="filter-sidebar">
          <div class="sidebar-heading">
            <div>
              <span class="eyebrow">DISCOVER</span>
              <h2>Filters</h2>
            </div>

            <span class="filter-icon" aria-hidden="true">☷</span>
          </div>

          <div class="filter-field search-field">
            <label for="search-filter">Search titles</label>
            <div class="search-input-wrap">
              <span aria-hidden="true">⌕</span>
              <input
                id="search-filter"
                type="search"
                placeholder="Search movies..."
                autocomplete="off"
              />
            </div>
          </div>

          <div class="filter-field">
            <label for="type-filter">Content type</label>
            <select id="type-filter">
              <option value="all">All content</option>
              <option value="movie">Movies</option>
              <option value="series">TV Series</option>
            </select>
          </div>

          <div class="filter-field">
            <label for="year-filter">Release year</label>
            <select id="year-filter">
              <option value="all">All years</option>
              {years.map((year) => (
                <option value={String(year)}>{year}</option>
              ))}
            </select>
          </div>

          <div class="filter-field">
            <label for="category-filter">Category</label>
            <select id="category-filter">
              <option value="all">All categories</option>
              {categories.map(([slug, name]) => (
                <option value={slug}>{name}</option>
              ))}
            </select>
          </div>

          <div class="filter-field">
            <label for="rating-filter">Minimum IMDb rating</label>
            <select id="rating-filter">
              <option value="0">Any rating</option>
              <option value="5">5.0+</option>
              <option value="6">6.0+</option>
              <option value="7">7.0+</option>
              <option value="8">8.0+</option>
              <option value="9">9.0+</option>
            </select>
          </div>

          <div class="filter-field">
            <label for="sort-filter">Sort by</label>
            <select id="sort-filter">
              <option value="featured">Featured order</option>
              <option value="newest">Newest added</option>
              <option value="oldest">Oldest added</option>
              <option value="rating-desc">IMDb: High to Low</option>
              <option value="rating-asc">IMDb: Low to High</option>
              <option value="year-desc">Release Year: Newest</option>
              <option value="year-asc">Release Year: Oldest</option>
              <option value="title-asc">Title: A–Z</option>
              <option value="title-desc">Title: Z–A</option>
            </select>
          </div>

          <button class="clear-button" id="clear-filters" type="button">
            <span aria-hidden="true">↺</span>
            Clear All Filters
          </button>

        </aside>

        <div class="catalog-content">
          <div class="catalog-toolbar">
            <div>
              <span class="eyebrow">YOUR COLLECTION</span>
              <h2>Explore titles</h2>
            </div>

            <span class="results-count" id="results-count" aria-live="polite">
              Loading titles...
            </span>
          </div>

          <p class="filter-status" id="filter-status" aria-live="polite"></p>

          <section class="movie-section" id="movies">
            <div class="section-heading">
              <div>
                <span class="eyebrow">FRESHLY ADDED</span>
                <h2>Latest Movies</h2>
              </div>
              <span class="section-number"></span>
            </div>
            <MovieSection heading="" items={movies} />
          </section>

          <section class="movie-section" id="series">
            <div class="section-heading">
              <div>
                <span class="eyebrow">BINGE-WORTHY STORIES</span>
                <h2>Latest TV Series</h2>
              </div>
              <span class="section-number"></span>
            </div>
           <MovieSection
  heading="Latest TV Series"
  items={series}
  mediaType="series"
/>
          </section>

          <section class="movie-section" id="top-movies">
            <div class="section-heading">
              <div>
                <span class="eyebrow">AUDIENCE FAVORITES</span>
                <h2>Top Rated Movies</h2>
              </div>
              <span class="section-number"></span>
            </div>
            <MovieSection heading="" items={topMovies} />
          </section>

          <section class="movie-section" id="top-series">
            <div class="section-heading">
              <div>
                <span class="eyebrow">HIGHLY RATED</span>
                <h2>Top Rated TV Series</h2>
              </div>
              <span class="section-number"></span>
            </div>
            <MovieSection
  heading="Top Rated TV Series"
  items={topSeries}
  mediaType="series"
/>
          </section>

          <div class="no-results" id="no-results" hidden>
            <div class="no-results-icon">⌕</div>
            <h3>No titles found</h3>
            <p>Try changing your filters or using another search term.</p>
            <button class="clear-button" id="empty-clear" type="button">
              Clear Filters
            </button>
          </div>
        </div>
      </div>
    </main>

    <footer class="site-footer">
      <a class="brand footer-brand" href="/">
        <span class="brand-icon">C</span>
        <span>CINE<span class="brand-accent">VERSE</span></span>
      </a>
      <p>Discover stories. Explore worlds.</p>
      <span class="copyright">© {new Date().getFullYear()} CineVerse</span>
    </footer>
  </body>
</html>

<script>
  const searchInput = document.querySelector("#search-filter") as HTMLInputElement;
  const typeFilter = document.querySelector("#type-filter") as HTMLSelectElement;
  const yearFilter = document.querySelector("#year-filter") as HTMLSelectElement;
  const categoryFilter = document.querySelector("#category-filter") as HTMLSelectElement;
  const ratingFilter = document.querySelector("#rating-filter") as HTMLSelectElement;
  const sortFilter = document.querySelector("#sort-filter") as HTMLSelectElement;

  const resultCount = document.querySelector("#results-count") as HTMLElement;
  const filterStatus = document.querySelector("#filter-status") as HTMLElement;
  const noResults = document.querySelector("#no-results") as HTMLElement;

  const sections = Array.from(
    document.querySelectorAll<HTMLElement>(".movie-section")
  );

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>(".movie-card")
  );

  // Keep each card's original position so Featured order can be restored.
  sections.forEach((section) => {
    const grid = section.querySelector(".movie-grid");
    if (!grid) return;

    Array.from(grid.querySelectorAll<HTMLElement>(".movie-card")).forEach(
      (card, index) => {
        card.dataset.originalIndex = String(index);
      }
    );
  });

  function sortCards() {
    const mode = sortFilter.value;

    sections.forEach((section) => {
      const grid = section.querySelector(".movie-grid");
      if (!grid) return;

      const sectionCards = Array.from(
        grid.querySelectorAll<HTMLElement>(".movie-card")
      );

      sectionCards.sort((a, b) => {
        const titleA = a.dataset.title || "";
        const titleB = b.dataset.title || "";
        const ratingA = Number(a.dataset.rating || -1);
        const ratingB = Number(b.dataset.rating || -1);
        const yearA = Number(a.dataset.year || 0);
        const yearB = Number(b.dataset.year || 0);
        const dateA = Date.parse(a.dataset.createdAt || "") || 0;
        const dateB = Date.parse(b.dataset.createdAt || "") || 0;
        const indexA = Number(a.dataset.originalIndex || 0);
        const indexB = Number(b.dataset.originalIndex || 0);

        switch (mode) {
          case "newest":
            return dateB - dateA;
          case "oldest":
            return dateA - dateB;
          case "rating-desc":
            return ratingB - ratingA;
          case "rating-asc":
            return ratingA - ratingB;
          case "year-desc":
            return yearB - yearA;
          case "year-asc":
            return yearA - yearB;
          case "title-asc":
            return titleA.localeCompare(titleB);
          case "title-desc":
            return titleB.localeCompare(titleA);
          default:
            return indexA - indexB;
        }
      });

      sectionCards.forEach((card) => grid.appendChild(card));
    });
  }

  function applyFilters() {
    const search = searchInput.value.trim().toLowerCase();
    const selectedType = typeFilter.value;
    const selectedYear = yearFilter.value;
    const selectedCategory = categoryFilter.value.toLowerCase();
    const minimumRating = Number(ratingFilter.value);

    let visibleTotal = 0;
    let activeFilters = 0;

    if (search) activeFilters++;
    if (selectedType !== "all") activeFilters++;
    if (selectedYear !== "all") activeFilters++;
    if (selectedCategory !== "all") activeFilters++;
    if (minimumRating > 0) activeFilters++;
    if (sortFilter.value !== "featured") activeFilters++;

    cards.forEach((card) => {
      const title = card.dataset.title || "";
      const year = card.dataset.year || "";
      const rating = Number(card.dataset.rating || 0);
      const categoryData = (card.dataset.category || "").toLowerCase();
      const type = (card.dataset.type || "").toLowerCase();

      const matchesSearch = !search || title.includes(search);
      const matchesType = selectedType === "all" || type === selectedType;
      const matchesYear = selectedYear === "all" || year === selectedYear;
      const matchesCategory =
        selectedCategory === "all" ||
        categoryData.split("|").includes(selectedCategory);
      const matchesRating = rating >= minimumRating;

      const visible =
        matchesSearch &&
        matchesType &&
        matchesYear &&
        matchesCategory &&
        matchesRating;

      card.hidden = !visible;

      if (visible) visibleTotal++;
    });

    sections.forEach((section) => {
      const visibleCards = section.querySelectorAll(
        ".movie-card:not([hidden])"
      ).length;

      section.hidden = visibleCards === 0;
    });

    resultCount.textContent =
      `${visibleTotal} ${visibleTotal === 1 ? "title" : "titles"}`;

    filterStatus.textContent = activeFilters
      ? `${activeFilters} filter${activeFilters === 1 ? "" : "s"} applied`
      : "Showing all available titles";

    noResults.hidden = visibleTotal > 0;
  }

  function refreshCatalog() {
    sortCards();
    applyFilters();
  }

  searchInput.addEventListener("input", applyFilters);
  typeFilter.addEventListener("change", applyFilters);
  yearFilter.addEventListener("change", applyFilters);
  categoryFilter.addEventListener("change", applyFilters);
  ratingFilter.addEventListener("change", applyFilters);
  sortFilter.addEventListener("change", refreshCatalog);

  function clearFilters() {
    searchInput.value = "";
    typeFilter.value = "all";
    yearFilter.value = "all";
    categoryFilter.value = "all";
    ratingFilter.value = "0";
    sortFilter.value = "featured";

    refreshCatalog();
  }

  document
    .querySelector("#clear-filters")
    ?.addEventListener("click", clearFilters);

  document
    .querySelector("#empty-clear")
    ?.addEventListener("click", clearFilters);

  refreshCatalog();
</script>

<style>
